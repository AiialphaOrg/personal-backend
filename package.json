{
  "name": "@personalos/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-prisma.js && tsx watch src/index.ts",
    "build": "node scripts/prepare-prisma.js && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "postinstall": "node scripts/prepare-prisma.js && prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "use:postgres": "node scripts/prepare-prisma.js postgresql && prisma generate",
    "use:mysql": "node scripts/prepare-prisma.js mysql && prisma generate",
    "prisma:generate": "node scripts/prepare-prisma.js && prisma generate",
    "prisma:migrate": "node scripts/prepare-prisma.js && prisma migrate dev",
    "prisma:push": "node scripts/prepare-prisma.js && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.3",
    "typescript": "~5.9.0"
  }
}
