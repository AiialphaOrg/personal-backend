# ===================================================
# Personal OS — Backend Environment Variables (Neon DB)
# ===================================================

# 1. Neon PostgreSQL Connection URL (from Neon Console: Dashboard -> Connection string -> Prisma / Pooled)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require"

# 2. Neon Direct URL (Optional, for direct migrations if using connection pooler)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/neondb?sslmode=require"

# 3. Server Port
PORT=4000

# 4. Node Environment
NODE_ENV=development

# 5. Quote Cache Duration
QUOTE_CACHE_TTL_HOURS=24
